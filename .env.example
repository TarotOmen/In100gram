# Existing Render PostgreSQL connection string. Do not create another database.
DATABASE_URL=
NODE_ENV=production
PORT=3000

# Telegram bot token from @BotFather. Required to verify Mini App initData and optionally send result photos.
TELEGRAM_BOT_TOKEN=

# Tribute webhook signing secret from Tribute settings.
TRIBUTE_WEBHOOK_SECRET=
# Exact product_id from an actual signed Tribute webhook for https://web.tribute.tg/p/HHk
TRIBUTE_PRODUCT_ID=
TRIBUTE_PRODUCT_URL=https://web.tribute.tg/p/HHk

# Deployed Google Apps Script Web App URL ending in /exec. It must return the Images sheet as JSON.
GOOGLE_APPS_SCRIPT_URL=
